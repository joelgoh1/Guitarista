# ---- web ----
NEXT_PUBLIC_API_URL=http://localhost:8000
# set to "false" if alphaTab workers fail to spawn in your browser/bundler
NEXT_PUBLIC_ALPHATAB_WORKERS=true

# ---- api (prefix GUITARISTA_) ----
GUITARISTA_DATA_DIR=./data
GUITARISTA_DB_URL=sqlite+aiosqlite:///./data/guitarista.db
GUITARISTA_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
GUITARISTA_LOG_LEVEL=INFO

# tier toggles + timeouts (seconds)
GUITARISTA_ENABLE_SONGSTERR=true
GUITARISTA_ENABLE_UG=true
GUITARISTA_ENABLE_AUDIO_TIER=true
# YouTube audio fetch via yt-dlp is legally gray; off by default. Flip to true locally if you want it.
# When on, the audio tier searches YouTube for the resolved song and verifies each hit against
# Spotify's duration before downloading; pass `audio_url` on a job to name the video yourself.
GUITARISTA_ENABLE_YTDLP=false
# Demucs guitar-stem separation (needs `uv sync --extra separate` in apps/ml, downloads ~80MB weights)
GUITARISTA_ENABLE_SEPARATION=false
GUITARISTA_TIER_TIMEOUT_SONGSTERR=20
GUITARISTA_TIER_TIMEOUT_UG=30
GUITARISTA_TIER_TIMEOUT_AUDIO=900

# Spotify (optional; create an app at https://developer.spotify.com/dashboard)
GUITARISTA_SPOTIFY_CLIENT_ID=
GUITARISTA_SPOTIFY_CLIENT_SECRET=
# Noodle mode logs in as *you* (Authorization Code + PKCE, no secret needed). Spotify only accepts
# literal loopback redirect URIs, so this must be 127.0.0.1 and must match the dashboard exactly.
GUITARISTA_SPOTIFY_REDIRECT_URI=http://127.0.0.1:8000/api/v1/spotify/callback
# Where the OAuth callback sends the browser back to (the Next.js app).
GUITARISTA_WEB_BASE_URL=http://localhost:3000

# Noodle mode: pick songs from your Spotify listening history and pre-generate their tabs
GUITARISTA_NOODLE_ENABLED=true
GUITARISTA_NOODLE_PREFETCH_TARGET=5
GUITARISTA_NOODLE_REFRESH_HOURS=6

# LLM assist via OpenRouter (optional; empty key disables all LLM calls)
GUITARISTA_OPENROUTER_API_KEY=
GUITARISTA_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
GUITARISTA_LLM_MODEL=qwen/qwen3.8-flash
GUITARISTA_LLM_TIMEOUT=30

# ML sidecar (apps/ml, Python 3.11)
GUITARISTA_ML_CMD=uv run --directory ../ml guitarista-ml
GUITARISTA_ML_MODELS_DIR=./data/models
GUITARISTA_DEMUCS_MODEL=htdemucs_6s
GUITARISTA_FFMPEG_BIN=ffmpeg
GUITARISTA_YTDLP_BIN=yt-dlp

# Score import: MuseScore Studio (free, https://musescore.org/download) converts .mscz /
# Guitar Pro / Capella files to MusicXML. Optional -- without it, score upload still accepts
# MusicXML and MIDI. Well-known install paths are auto-detected; set this to override.
GUITARISTA_MSCORE_BIN=mscore
GUITARISTA_SCORE_CONVERT_TIMEOUT=60
